# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual Environment - ignore contents but keep folder
cuda_env/*
!cuda_env/.gitkeep
venv/*
!venv/.gitkeep
env/
ENV/

# Jupyter Notebook
.ipynb_checkpoints

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Data files - ignore contents but keep folder structure
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*.parquet
data/processed/*.duckdb

# Large file types
*.dat
*.hea

# Model checkpoints - ignore contents but keep folder
models/checkpoints/*
!models/checkpoints/.gitkeep

# Generated visualizations - ignore contents but keep folder
*.png
*.jpg
*.jpeg

# OS
.DS_Store
Thumbs.db

# Logs
*.log
