# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual Environment - ignore contents but keep folder
cuda_env/*
!cuda_env/.gitkeep
venv/*
!venv/.gitkeep
env/
ENV/

# Jupyter Notebook
.ipynb_checkpoints

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Data files
data/
# ...but src/data/ is code (ECG dataset loader), not data
!src/data/

# Large file types
*.dat
*.hea

# Model checkpoints
models/*
!models/baselines/
!models/baselines/*



# Generated visualizations - ignore contents but keep folder
*.png
*.jpg
*.jpeg
# ...except the MCP server's figure assets, which the manifest pins by hash
!local_mcp/assets/figures/*.png

# MCP client configs hold machine-specific absolute paths: commit the templates in local_mcp/configs/templates/
# only (.vscode/mcp.json is already covered by .vscode/ above)
local_mcp/configs/rendered/
.mcp.json
.mcp.json.bak
.cursor/
.agents/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Documents
*.pdf

datasets*
